ersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"20\" y=\"20\"></block>\n  <block type=\"device_forever\" x=\"225\" y=\"20\"></block>\n</xml>","main.ts":"// made with love https://helloacm.com/microbit-programming-the-development-of-a-snake-eating-apple-game-and-ai-version-1-snake-does-not-grow/\n\nlet direction = 0;\nlet dxOffset = [[1, 0], [0, 1], [-1, 0], [0, -1]];\nlet score = 0;\nlet px = 0;\nlet py = 0;\nlet snake = game.createSprite(px, py);\nlet apple = game.createSprite(2, 2);\nplaceNextApple();\n\nfunction validPixelCoordinate(nx: Number, ny: Number): boolean {\n    return (nx >= 0 && nx <= 4 && ny >= 0 && ny <= 4);\n}\n\nfunction gameOver() {\n    game.setScore(score);\n    game.pause();\n    basic.pause(1000);\n    game.gameOver();\n}\n\nfunction resetGame() {\n    game.setScore(0);\n    score = 0;\n    direction = 0;    \n    px = 0;\n    py = 0;\n    snake.goTo(px, py);\n    placeNextApple();\n    game.resume();\n}\n\nfunction moveForward() {\n    let dx = dxOffset[direction];\n    px += dx[0];\n    py += dx[1];\n    if (!validPixelCoordinate(px, py)) {\n        gameOver();\n    }\n}\n\nfunction placeNextApple() {\n    let x, y;\n    do {\n        x = Math.randomRange(0, 4);\n        y = Math.randomRange(0, 4);\n    } while ((x == snake.x()) && (y == snake.y()))\n    apple.goTo(x, y);\n    apple.setBrightness(100);\n}\n\nfunction turnLeft() {\n    direction = (direction + 3) % 4;\n}\n\nfunction turnRight() {\n    direction = (direction + 1) % 4;\n}\n\ninput.onButtonPressed(Button.A, function () {\n    turnLeft();\n})\n\ninput.onButtonPressed(Button.B, function () {\n    turnRight();\n})\n\ninput.onButtonPressed(Button.AB, function () {\n    resetGame();\n})\n\nbasic.forever(function () {\n    if (game.isGameOver()) {\n        return;\n    }\n    let delay = Math.max(100, 1000 - score * 50);\n    basic.pause(delay);\n    moveForward();\n    snake.goTo(px, py);\n    if (snake.isTouching(apple)) {\n        score++;\n        placeNextApple();\n    }\n})","README.md":"","pxt.json":"{\n    \"name\": \"snake-game-v1\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\"\n    },\n    \"description\": \"\",\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\",\n    \"targetVersions\": {\n        \"branch\": \"v2.0.10\",\n        \"tag\": \"v2.0.10\",\n        \"commits\": \"https://github.com/microsoft/pxt-microbit/commits/9b7b5f1d10f133bc9c14ef24e1b8a67333f12c29\",\n        \"target\": \"2.0.10\",\n        \"pxt\": \"5.15.13\"\n    }\n}"}},{"timestamp":1746689985351,"editorVersion":"7.0.61","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"l}WgYo.CtO_i~;HW[MSq\">score</variable><variable id=\"ZP/+!]+ts`ipLoJ0JmPo\">direction</variable><variable id=\"NcSZ-aYBb~#Isx1lC61#\">px</variable><variable id=\"j0Q/Z+4STi]?:?-Rr.qr\">py</variable><variable id=\"eJ(|P?31.H-4t)MA2Bp+\">dx</variable><variable id=\"^SU|y+Zd]A{exUz,|_Q!\">dxOffset</variable><variable id=\";=0Jsdv3,X)LBv1G061M\">delay</variable><variable id=\"g]d/XTM:d`=OT{5GF4n@\">snake</variable><variable id=\"tG{a1xm?NwsOnnzeO;0+\">apple</variable></variables><comment x=\"812.046875\" y=\"1332\" w=\"480\" h=\"120\">\nmade with love https://helloacm.com/microbit-programming-the-development-of-a-snake-eating-apple-game-and-ai-version-1-snake-does-not-grow/\n</comment><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"let py = 0\" numlines=\"1\" declaredvars=\"py\"></mutation><next><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"let px = 0\" numlines=\"1\" declaredvars=\"px\"></mutation><next><block type=\"variables_set\"><field name=\"VAR\" id=\"^SU|y+Zd]